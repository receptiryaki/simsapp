# Environment overrides for scripts/release.sh.
# Copy to .env to use; .env is gitignored.
#
#   cp .env.example .env
#
# All values optional — release.sh has sane defaults.

# Name of the notarytool keychain profile created during one-time
# setup (see scripts/DISTRIBUTION.md). Default: SimsNotary.
# NOTARY_PROFILE=SimsNotary
