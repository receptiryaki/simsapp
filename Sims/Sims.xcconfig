// Build configuration for the Sims target.
//
// Defaults live here. Per-developer overrides go in Sims/Local.xcconfig,
// which is gitignored — see Sims/Local.xcconfig.example for the template.
// The #include? form silently skips the override file when absent, so
// fresh clones build (Debug, ad-hoc signed) without any local setup.

// Released version. Bump this when cutting a release; the GitHub
// Actions release workflow verifies the pushed tag (e.g. v0.2.0)
// matches this value before building.
MARKETING_VERSION = 0.1.0

// Internal build number. Kept in lockstep with MARKETING_VERSION so
// there's one knob to turn. Apple only requires this to be a 1-3
// component numeric string and (for App Store) monotonically
// increasing — neither applies to our Developer ID / notarized
// distribution, but keeping it equal to the marketing version is
// simpler than tracking a separate counter.
CURRENT_PROJECT_VERSION = $(MARKETING_VERSION)

// Reverse-DNS bundle identifier. Override in Local.xcconfig to use
// your own (e.g. com.yourname.sims) before shipping a Release build.
PRODUCT_BUNDLE_IDENTIFIER = com.example.sims

// Apple Developer Team ID. Required for Release / Developer ID /
// notarized builds. Find yours in Xcode → Settings → Accounts.
// Leave empty to build Debug only.
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
